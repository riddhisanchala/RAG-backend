# ─────────────────────────────────────────────────────────────
# Arche backend — environment variables
# Copy this file to `.env` for local development.
# On Render, add the same variables in the dashboard (Environment tab).
# NEVER commit a real `.env` file.
# ─────────────────────────────────────────────────────────────

# Render sets PORT automatically (10000). Only used locally.
PORT=5000

# REQUIRED. MongoDB Atlas connection string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/secure_rag?retryWrites=true&w=majority
# (URL-encode special characters in the password)
MONGO_URI=

# REQUIRED. Random secret for signing login tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# REQUIRED. Must be exactly 64 hex characters (32 bytes). Encrypts provider API keys stored in MongoDB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you change it later, previously saved provider API keys can no longer be decrypted.
ENCRYPTION_KEY=

# REQUIRED in production. Your Vercel frontend URL(s), comma-separated, NO trailing slash.
# e.g. https://arche-frontend.vercel.app
# (http://localhost:* is always allowed for local development)
CORS_ORIGIN=

# Optional. Enables "Continue with Google". Leave empty to disable.
GOOGLE_CLIENT_ID=

# Where uploads + FAISS indexes are stored. On Render FREE this disk is temporary (wiped on restart/redeploy).
DATA_DIR=./data
MAX_UPLOAD_MB=25

# true  = create admin/admin + demo users (hr01, employee01) if they don't exist.
# Set to false once you have created your own admin account.
SEED_DEFAULT_USERS=true

RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.12
